@page
@model EPPMS.Portal.Areas.Admin.Pages.Applications.IndexModel

@{
    ViewData["Title"] = "Applications";
}

@section Styles
{
    <link href="~/css/admin/application/applicationindex.css"  rel="stylesheet"  asp-append-version="true" />
}

<div class="applications-page">
    <!-- ==========================================
         Application Header
    =========================================== -->
    <section class="application-header">
        <div class="row align-items-center">
            <!-- Left -->
            <div class="col-xl-5 col-lg-12">
                <h1 class="page-title">Applications</h1>
                <p class="page-subtitle">Manage registered applications and product modules. </p>
            </div>

            <!-- Right -->
            <div class="col-xl-7 col-lg-12">
                <div class="application-toolbar-container">
                    <div class="application-toolbar">
                        <!-- Search -->
                       @*  <div class="application-search">
                            <input type="text" class="form-control application-search-input" placeholder="Search applications..." />
                            <button type="button" class="application-search-button"> <i class="bi bi-search"></i> </button>
                        </div> *@
                        <!-- Health Filter -->
                        <div class="dropdown">
                            <button class="btn application-filter-button dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-funnel"></i>
                                Health Filter
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">All Applications</a></li>
                                <li><a class="dropdown-item" href="#">Healthy</a></li>
                                <li><a class="dropdown-item" href="#">Warning</a></li>
                                <li><a class="dropdown-item" href="#">Critical</a></li>
                            </ul>
                        </div>
                        <!-- More Actions -->
                        <div class="dropdown">
                            <button class="btn application-filter-button dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                More Actions
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">Export</a></li>
                                <li><a class="dropdown-item" href="#">Import</a></li>
                            </ul>
                        </div>

                        <!-- New Application -->
                        <a asp-page="./Create"
                               class="btn application-create-button"
                               style="position:relative; z-index:9999;">
                            <i class="bi bi-plus-lg"></i>
                            New Application
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================
         Statistics
    =========================================== -->
    <section class="statistics-section">
        <div class="row g-3">
            <!-- Total Applications -->
            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <article class="stat-card">
                    <div class="stat-icon stat-primary">
                        <i class="bi bi-grid-3x2-gap"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-title">
                            Total<br/>Applications
                        </h3>
                        <div class="stat-value">
                           @Model.Applications.Count()
                        </div>
                       @*  <div class="stat-change positive">
                            <i class="bi bi-arrow-up"></i>
                            <span>12%</span>
                            <small>vs last month</small>
                        </div> *@
                    </div>
                </article>
            </div>

            <!-- Healthy -->
            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <article class="stat-card">
                    <div class="stat-icon stat-success">
                        <i class="bi bi-heart-pulse"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-title">
                            Healthy Applications
                        </h3>
                        <div class="stat-value">
                            @(Model.Applications.Where(x => x.CurrentHealth == "Excellent").Count() +
                              Model.Applications.Where(x => x.CurrentHealth == "Good").Count())
                        </div>
                       @*  <div class="stat-change positive">
                            <i class="bi bi-arrow-up"></i>
                            <span>9%</span>
                            <small>vs last month</small>
                        </div> *@
                    </div>
                </article>
            </div>
            <!-- Warning -->
            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <article class="stat-card">
                    <div class="stat-icon stat-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-title">
                            Warning Applications
                        </h3>
                        <div class="stat-value">
                            @Model.Applications.Where(x => x.CurrentHealth == "Warning").Count()
                        </div>                        
                    </div>
                </article>
            </div>

            <!-- Critical -->
            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <article class="stat-card">
                    <div class="stat-icon stat-danger">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-title">
                            Critical Applications
                        </h3>
                        <div class="stat-value">
                            @Model.Applications.Where(x => x.CurrentHealth == "Critical").Count()
                        </div>
                        @* <div class="stat-change negative">
                            <i class="bi bi-arrow-down"></i>
                            <span>8%</span>
                            <small>vs last month</small>
                        </div> *@
                    </div>
                </article>
            </div>

            <!-- Recently Updated -->
            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <article class="stat-card">
                    <div class="stat-icon stat-info">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-title">
                            Recently<br />Updated
                        </h3>
                        <div class="stat-value">
                            18
                        </div>
                     @*    <div class="stat-change positive">
                            <i class="bi bi-arrow-up"></i>
                            <span>15%</span>
                            <small>vs last month</small>
                        </div> *@
                    </div>
                </article>
            </div>

            <!-- Without Features -->
            <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                <article class="stat-card">
                    <div class="stat-icon stat-secondary">
                        <i class="bi bi-box"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-title">
                            Without <br />Features
                        </h3>
                        <div class="stat-value">
                            5
                        </div>
                      @*   <div class="stat-change negative">
                            <i class="bi bi-arrow-down"></i>
                            <span>5%</span>
                            <small>vs last month</small>
                        </div> *@
                    </div>
                </article>
            </div>
        </div>
    </section>
    <!-- ==========================================
         Application List
    =========================================== -->
    <section class="application-list">
        <div class="application-list-card">
            <!-- Header -->
            <div class="application-list-header">
                <div>
                    <h2 class="application-list-title">
                        Application List
                    </h2>
                    <p class="application-list-subtitle">
                        Showing @Model.Applications.Count application(s)
                    </p>
                </div>
            </div>
            @if (!Model.Applications.Any())
            {
                <div class="application-empty-state">
                    <i class="bi bi-grid-3x2-gap"></i>
                    <h4>
                        No applications found
                    </h4>
                    <p>
                        There are currently no registered applications.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table application-table">
                        <colgroup>
                            <col style="width:22%;" />
                            <col style="width:26%;" />
                            <col style="width:12%;" />
                            <col style="width:18%;" />
                            <col style="width:10%;" />
                            <col style="width:12%;" />
                            <col style="width:6%;" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="text-center">Application / Module</th> 
                                <th class="text-center">Purpose</th>
                                <th class="text-center">Current Health</th>
                                <th class="text-center">Technical Details</th>
                                <th class="text-center">Updated By</th>
                                <th class="text-center">Updated Date</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var application in Model.Applications)
                            {
                                <tr>
                                    <!-- Application -->
                                    <td class="text-center">
                                        <div class="application-name">
                                            @application.ApplicationModule
                                        </div>
                                    </td>
                                    <!-- Purpose -->
                                    <td class="text-center">
                                        @application.Purpose
                                    </td>
                                    <!-- Health -->
                                    <td class="text-center">
                                        <span class="application-health-badge @application.CurrentHealth.Replace(" ", "-").ToLowerInvariant()">
                                            @application.CurrentHealth
                                        </span>
                                    </td>
                                    <!-- Technical Details -->
                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(application.TechDetails))
                                        {
                                            foreach (var technology in application.TechDetails.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <div>@technology.Trim()</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <!-- Updated By -->
                                    <td class="text-center">
                                        @application.UpdatedBy.Replace("MS/", "")
                                    </td>
                                    <!-- Updated Date -->
                                    <td class="text-center">
                                        <div>
                                            @(application.UpdatedDateTime?.ToString("MMM dd, yyyy") ?? "—")
                                        </div>                                       
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">
                                        <div class="dropdown">
                                            <button class="btn application-action-button"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item" href="#">
                                                        <i class="bi bi-eye me-2"></i>
                                                        View Details
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="#">
                                                        <i class="bi bi-pencil-square me-2"></i>
                                                        Edit
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="#">
                                                        <i class="bi bi-arrow-repeat me-2"></i>
                                                        Update Status
                                                    </a>
                                                </li>
                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="#">
                                                        <i class="bi bi-list-task me-2"></i>
                                                        View Tasks
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="#">
                                                        <i class="bi bi-bug me-2"></i>
                                                        View Bugs
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="#">
                                                        <i class="bi bi-clock-history me-2"></i>
                                                        Audit Trail
                                                    </a>
                                                </li>
                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>
                                                <li>
                                                    <a class="dropdown-item text-danger" href="#">
                                                        <i class="bi bi-trash me-2"></i>
                                                        Delete
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer -->
                <div class="application-list-footer">
                    <div>
                        Showing
                        <strong>@Model.Applications.Count</strong>
                        application(s)
                    </div>
                    <nav>
                        <!-- Pagination will be added later -->
                    </nav>
                </div>
            }
        </div>
    </section>
</div>
